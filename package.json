{
  "name": "unique-av-osee-remote",
  "productName": "Unique AV OSEE Remote",
  "version": "1.0.0",
  "description": "Control OSEE GoStream switchers (Deck, Deck Plus, Duet, Duet SDI, Duet 8 ISO) from an iPad.",
  "main": "main.js",
  "author": "Unique AV",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "server": "node osee/server.js",
    "sim": "node osee/sim.js",
    "test": "node test/unit-osee.mjs && node test/unit-updater.mjs",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.uniqueav.oseeremote",
    "productName": "Unique AV OSEE Remote",
    "copyright": "Copyright © Unique AV",
    "files": [
      "main.js",
      "main/**/*",
      "osee/**/*",
      "!osee/osee-devices.json",
      "package.json",
      "build/icon.png"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Jeansenekal-tech/unique-av-osee-remote/releases/latest/download"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "target": ["dmg", "zip"],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Unique-AV-OSEE-Remote-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Unique AV OSEE Remote",
      "artifactName": "Unique-AV-OSEE-Remote-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Unique-AV-OSEE-Remote-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Unique AV OSEE Remote"
    },
    "afterSign": "scripts/adhoc-sign.cjs"
  },
  "updateUrl": "https://github.com/Jeansenekal-tech/unique-av-osee-remote/releases/latest/download",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeansenekal-tech/unique-av-osee-remote.git"
  }
}
